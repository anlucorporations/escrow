# ============================================================================
# TrueKeate — Variables de entorno para GCP (Cloud Run + Cloud SQL + Foundry)
# ============================================================================
# NO es un archivo de configuración que se suba: es la DOCUMENTACIÓN de las
# variables que consume la aplicación. En GCP los valores se inyectan así:
#
#   SECRETOS  (críticos)   → GCP Secret Manager, referenciados con --set-secrets
#   PÚBLICAS  (direcciones)-> --set-env-vars en `gcloud run deploy`
#   BUILD-TIME (NEXT_PUBLIC_*) → ARG del Dockerfile (se inlinean en el bundle
#                            del cliente durante `next build`).
#
# Copia este archivo como referencia local si quieres replicar el entorno:
#   cp web/.env.gcp.example web/.env.gcp     # NO versionar (ver .gitignore)
# ============================================================================

# ---------------------------------------------------------------------------
# A. SECRETOS (GCP Secret Manager — NUNCA en git, NUNCA en el frontend)
# ---------------------------------------------------------------------------
# Se crean con:
#   gcloud secrets create DATABASE_URL       --data-file=-
#   gcloud secrets create RPC_URL            --data-file=-
#   gcloud secrets create KYC_SECRET         --data-file=-
#   gcloud secrets create RELAYER_PRIVATE_KEY --data-file=-
#
# y se inyectan en Cloud Run con:
#   --set-secrets="DATABASE_URL=DATABASE_URL:latest,RPC_URL=RPC_URL:latest, \
#                  KYC_SECRET=KYC_SECRET:latest,RELAYER_PRIVATE_KEY=RELAYER_PRIVATE_KEY:latest"

# Conexión a Cloud SQL (PostgreSQL 15 + PostGIS).
# Cloud Run + --add-cloudsql-instances (recomendado, socket Unix privado):
#   postgres://app:<CLAVE>@/truekeate?host=/cloudsql/PROYECTO:REGION:INSTANCIA
# IP pública con TLS:
#   postgres://app:<CLAVE>@<IP>:5432/truekeate?sslmode=require
DATABASE_URL=

# Endpoint del nodo Foundry/Anvil remoto (o red L2) en GCP:
#   http://<IP-INTERNA-O-PUBLICA-DEL-NODO>:8545
RPC_URL=

# Clave simétrica AES-256-GCM para cifrar datos KYC (correo, teléfono, 2FA).
# Generar: openssl rand -hex 32
KYC_SECRET=

# Clave privada ECDSA del relayer de meta-transacciones (EIP-712 sin gas).
# Debe estar financiada en la red destino. NUNCA una clave de Anvil por defecto.
RELAYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# B. VARIABLES PÚBLICAS — direcciones de contratos desplegados en el nodo remoto
# ---------------------------------------------------------------------------
# Se obtienen tras ejecutar:  ./scripts/deploy-contracts-gcp.sh
# Se pasan a Cloud Run con --set-env-vars y como ARG de build del Dockerfile.
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_USER_REGISTRY_ADDRESS=
NEXT_PUBLIC_EXCHANGE_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_SUBSCRIPTION_ADDRESS=
NEXT_PUBLIC_TOKEN_A_ADDRESS=
NEXT_PUBLIC_TOKEN_B_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_DELIVERY_ADDRESS=
NEXT_PUBLIC_BRLT_ADDRESS=
NEXT_PUBLIC_SBT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TRUEKE_SBT_ADDRESS=
NEXT_PUBLIC_TRUEKE_RWA_ADDRESS=
NEXT_PUBLIC_TRUEKE_SERVICE_ADDRESS=

# Red destino (31337 para Anvil remoto; el chain id de la L2 si aplica)
NEXT_PUBLIC_CHAIN_ID=31337

# ---------------------------------------------------------------------------
# C. INDEXADOR / JOBS (Cloud Run Jobs o VM)
# ---------------------------------------------------------------------------
# Bloque inicial de sincronización histórica (backfill). 0 = desde el génesis.
START_BLOCK=0
# Tamaño de lote para getLogs.
CHUNK=1000

# ---------------------------------------------------------------------------
# D. INFRAESTRUCTURA (para `deploy-gcp.sh` / gcloud CLI — no las consume la app)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=truekeate-main
GCP_REGION=us-central1
# Instancia Cloud SQL: PROYECTO:REGION:INSTANCIA
CLOUDSQL_INSTANCE=truekeate-main:us-central1:truekeate-db-prod
# Service account de mínimo privilegio (roles: secretmanager.secretAccessor,
# cloudsql.client, logging.logWriter, monitoring.metricWriter)
GCP_SERVICE_ACCOUNT=truekeate-app-sa@truekeate-main.iam.gserviceaccount.com
# Imagen del contenedor (Artifact Registry / gcr.io)
GCP_IMAGE=gcr.io/truekeate-main/truekeate:latest
